{
	"name": "console",
	"version": "0.6.0",
	"description": "Service provider for read-only console panels",
	"license": "MIT",
	"type": "commonjs",
	"main": "./lib/console.js",
	"files": [
		"lib"
	],
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/atom-console.git"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "npm run build -- --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error --quiet",
		"lint:types": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"start": "npm run dev",
		"test": "npm run lint"
	},
	"engines": {
		"node:": "20.16",
		"pulsar": ">=1.132.0 <2.0.0"
	},
	"activationHooks": [
		"core:loaded-shell-environment"
	],
	"providedServices": {
		"console": {
			"description": "Read only log console",
			"versions": {
				"1.0.0": "provideConsole"
			}
		},
		"console-panel": {
			"description": "Read only log console",
			"versions": {
				"1.0.0": "provideConsole"
			}
		}
	},
	"dependencies": {
		"@atxm/developer-console": "^0.5.0",
		"event-kit": "^2.5.3"
	},
	"devDependencies": {
		"@children-of-atom/rosetta": "^0.1.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@idleberg/configs": "^0.4.6",
		"@types/atom": "^1.40.18",
		"@types/event-kit": "^2.4.4",
		"@types/node": "^26.2.0",
		"concurrently": "^10.0.5",
		"rollup-plugin-svelte": "^7.2.3",
		"svelte": "^3.59.2",
		"tsdown": "^0.22.14",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	}
}
