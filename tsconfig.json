{
	"extends": "@idleberg/configs/tsc",
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"verbatimModuleSyntax": false
	},
	"include": ["src/**/*", "tsdown.config.mts"]
}
